# Apache: serve index.html for any path so React Router can handle it client-side.
# The substitution below is intentionally relative ("index.html", not "/index.html")
# so this works whether the site is deployed at the domain root (public_html/) or
# in a subfolder (public_html/shop/) — an absolute path here would 404 on page
# refresh/direct links whenever the site is not installed at the server root.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
