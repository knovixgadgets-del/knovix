# URL of the WordPress site that has WooCommerce + the "Knovix API Bridge" plugin active.
# Must be the site's REAL, permanent address (no trailing slash, no /wp-json).
#
# CHECK IT: open  <this URL>/wp-json/knovix/v1/health  in a browser. You must see
#   {"ok":true,"plugin":"knovix-api-bridge","woocommerce":true,...}
# If you see an HTML page, a 404, or the browser jumps to another domain, this value is
# wrong (e.g. a temporary *.hostingersite.com address that now redirects) and the storefront
# will load with no products/categories. Fix it, then run `npm run build` again.
VITE_API_BASE_URL=https://plum-chimpanzee-542556.hostingersite.com
